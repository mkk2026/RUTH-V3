# Google Gemini API Key (Required for voice, CAD, web agent)
# Get yours here: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# Anthropic Claude API Key (Optional -- for alternative model provider)
# Get yours here: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI GPT API Key (Optional -- for alternative model provider)
# Get yours here: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Ollama Base URL (Optional -- defaults to http://localhost:11434)
# OLLAMA_BASE_URL=http://localhost:11434

# Shodan API Key (Optional -- for network security scanning)
# Get yours here: https://account.shodan.io/
SHODAN_API_KEY=

# Telegram Bot Token (Optional -- for Telegram messaging integration)
# Create a bot via @BotFather: https://core.telegram.org/bots#botfather
TELEGRAM_BOT_TOKEN=

# Discord Bot Token (Optional -- for Discord messaging integration)
# Create a bot: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=
